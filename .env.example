# Used by docker-compose.yml (copy to .env in the project root).
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=campusbite

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave empty for OpenAI. For GitHub Models use https://models.github.ai/inference,
# a GitHub token with models:read as OPENAI_API_KEY, and OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=
AI_RATE_LIMIT_PER_MINUTE=10

REMINDER_THRESHOLD_MINUTES=15
REMINDER_INTERVAL_SECONDS=60

SEED_DEMO_DATA=true
ALLOW_STAFF_REGISTRATION=true

# Upload limits for avatars, restaurant covers and dish photos/videos
MAX_IMAGE_MB=5
MAX_VIDEO_MB=50
